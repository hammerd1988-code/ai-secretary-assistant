# Required
OPENAI_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Optional: Supabase persistence (falls back to in-memory store if unset)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: voice module
# Twilio Console → Account Info → Auth Token. Used to validate webhook signatures.
TWILIO_AUTH_TOKEN=
# Public URL Twilio can reach (use an ngrok/tunnel URL in local dev).
PUBLIC_BASE_URL=http://localhost:8787

PORT=8787
